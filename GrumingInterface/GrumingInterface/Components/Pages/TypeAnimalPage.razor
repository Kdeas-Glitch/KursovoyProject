@page "/Animal"
@inject AppState State
@rendermode InteractiveServer

<PageTitle>Виды животных</PageTitle>

<h1 class="qwe">Виды животных</h1>

<ul class="item-list">

    @foreach (var item in Items)
    {
        bool isSelected = SelectedIdType == item.IdType;

        <li @key="item.IdType"
            class="item-card @(isSelected ? "selected" : "")"
            @onclick="() => SelectItem(item)">
            <strong>@item.Name</strong>
        </li>
    }
</ul>

@if (SelectedItem is not null)
{
    <p>Выбрано: <b>@SelectedItem.Name</b> (ID: @SelectedItem.IdType)</p>
}

<input id="animalName"
       type="text"
       @bind="name"
       @bind:event="oninput" />

<button @onclick="PostAnimal">Сохранить</button>
<button @onclick="DeleteAnimal">Удалить</button>




@code {

    private string name = "";

    private int? SelectedIdType;
    private TypeAnimal? SelectedItem => Items.FirstOrDefault(x => x.IdType == SelectedIdType);

    private List<TypeAnimal> Items = new();



    private void SelectItem(TypeAnimal item)
    {
        SelectedIdType = SelectedIdType == item.IdType ? null : item.IdType;
        if (name == "")
            name = item.Name;
        else
            name = "";
    }


    protected override async Task OnInitializedAsync()
    {
        await GetList();
    }

    private async Task GetList()
    {
        Items.Clear();

        var l = await State.client.GetFromJsonAsync<List<TypeAnimal>>($"api/Type");

        foreach (var i in l)
        {
            Items.Add(i);
        }
    }

    private async Task PostAnimal()
    {
        if (name != "")
        {
            if (SelectedIdType != null)
            {

                var r = await State.client.PatchAsJsonAsync(
                    $"api/Type/{SelectedIdType}",
                    new
                    {
                        Name = this.name
                    }
                );


                if (r.IsSuccessStatusCode)
                {
                    await GetList();
                }
            }
            else
            {
                var r = await State.client.PostAsJsonAsync(
                    $"api/Type",
                    new
                    {
                        Name = this.name
                    }
                );

                if (r.IsSuccessStatusCode)
                {
                    // TypeAnimal tp = new();
                    // tp.Name = name;

                    // Items.Add(tp);

                    await GetList();
                }
            }
        }
    }
    private async Task DeleteAnimal()
    {
        if (SelectedIdType != null)
        {
            var r = await State.client.DeleteAsync(
                $"api/Type/{SelectedIdType}"
            );

            if (r.IsSuccessStatusCode)
            {
                TypeAnimal tp = Items.FirstOrDefault(i => i.IdType==SelectedIdType);

                Items.Remove(tp);

                name = "";

                SelectedIdType = null;
            }
        }
    }
}
